{
  "name": "frida-mobile-mcp",
  "version": "0.3.0",
  "description": "Mobile Frida MCP Server - AI-powered mobile app exploration and testing via Frida instrumentation",
  "homepage": "https://github.com/monkeywave/frida-mobile-mcp#readme",
  "bugs": {
    "url": "https://github.com/monkeywave/frida-mobile-mcp/issues"
  },
  "author": "monkeywave",
  "mcpName": "io.github.monkeywave/frida-mobile-mcp",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "frida-mobile-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "build:bridges": "node build/bundle-bridges.mjs",
    "build": "npm run build:bridges && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build:bridges",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "frida",
    "mcp",
    "mobile",
    "android",
    "ios",
    "security",
    "instrumentation",
    "reverse-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/monkeywave/frida-mobile-mcp"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@toon-format/toon": "^4.4.0",
    "commander": "^15.0.0",
    "frida": "^17.24.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@frida/rollup-plugin-node-polyfills": "^4.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "frida-java-bridge": "^7.0.13",
    "frida-objc-bridge": "^8.0.6",
    "rollup": "^4.64.10",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "frida@17.24.3": true
  }
}
